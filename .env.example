# Needed for the AI audit, exploits, fix verification and chat (and as the engine if Slither is absent)
# OpenCode Zen key (set it in your host's environment settings, never in code). Model: space-bunny-free
OPENCODE_ZEN_API_KEY=
# Optional: only to switch away from the default space-bunny-free
AUDITLENS_MODEL=
RATE_LIMIT_PER_HOUR=20
# Fetch verified source by address (optional, can also be sent per request)
ETHERSCAN_API_KEY=
# Attestation contract on Sepolia (see contracts/deploy.py)
CONTRACT_ADDRESS=
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
# Optional RPC overrides per chain id, e.g. RPC_1=https://...
